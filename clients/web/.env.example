# YAiPlayer Web Environment Configuration
# API Origin for YAiPlayer Worker (auth, pairing, cloud registry, proxy streaming)
# If omitted or empty, the client uses the same origin as the frontend hosting (e.g. /api/v1)
VITE_API_URL=https://yai-iptv-sync-worker.example.workers.dev

# Optional TMDB API key for Discover metadata (client-side only, no hardcoded secrets)
VITE_TMDB_API_KEY=
