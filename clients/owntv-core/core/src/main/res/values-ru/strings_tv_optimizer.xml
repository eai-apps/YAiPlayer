    <string name="tv_optimizer_vendor_generic">Android TV (Универсально)</string>
    <string name="tv_optimizer_vendor_generic_steps">Настройки → Настройки устройства → Об устройстве → 7 раз нажать «Сборка» → Назад → Для разработчиков → Отладка по USB / сети</string>
    <string name="tv_optimizer_vendor_xiaomi">Xiaomi Mi TV / TV Box</string>
    <string name="tv_optimizer_vendor_xiaomi_steps">Настройки → Настройки устройства → Об устройстве → Сборка (7 раз) → Назад → Дополнительные настройки → Для разработчиков → Отладка по USB</string>
    <string name="tv_optimizer_vendor_sony">Sony BRAVIA</string>
    <string name="tv_optimizer_vendor_sony_steps">Настройки → Система → Об устройстве → Сборка ОС Android TV (7 раз) → Назад → Система → Для разработчиков → Отладка</string>
    <string name="tv_optimizer_vendor_tcl">TCL Android TV</string>
    <string name="tv_optimizer_vendor_tcl_steps">Настройки → Настройки устройства → О системе → Сборка (7 раз) → Назад → Для разработчиков → Отладка по USB</string>
    <string name="tv_optimizer_vendor_philips">Philips Android TV</string>
    <string name="tv_optimizer_vendor_philips_steps">Все настройки → Настройки Android → Настройки устройства → Об устройстве → Сборка (7 раз) → Назад → Для разработчиков</string>
    <string name="tv_optimizer_vendor_google">Google TV Streamer / Chromecast</string>
    <string name="tv_optimizer_vendor_google_steps">Настройки → Система → Об устройстве → Сборка ОС Android TV (7 раз) → Назад → Система → Для разработчиков → Отладка по сети</string>

    <string name="pkg_youtube_tv_title">YouTube TV</string>
    <string name="pkg_youtube_tv_desc">Приложение сервиса YouTube TV (не обычный YouTube). Можно безопасно отключать.</string>
    <string name="pkg_play_games_title">Google Play Игры</string>
    <string name="pkg_play_games_desc">Фоновая синхронизация игр Google Play. Можно отключать, если не играете на ТВ.</string>
    <string name="pkg_patchwall_title">Xiaomi PatchWall</string>
    <string name="pkg_patchwall_desc">Тяжёлая витрина рекомендаций Xiaomi. Отключение заметно ускоряет ТВ.</string>
    <string name="pkg_xiaomi_upgrade_title">Обновления Xiaomi</string>
    <string name="pkg_xiaomi_upgrade_desc">Фоновое обновление компонентов Xiaomi. Отключать с осторожностью.</string>
    <string name="pkg_sony_sync_title">Sony Bravia Sync</string>
    <string name="pkg_sony_sync_desc">HDMI-CEC служба синхронизации для звуковых панелей и аксессуаров Sony.</string>
    <string name="pkg_tcl_manager_title">TCL TV Manager</string>
    <string name="pkg_tcl_manager_desc">Фоновое служебное приложение и баннеры на телевизорах TCL.</string>
