    <string name="tv_optimizer_tile">Speed up TV</string>
    <string name="tv_optimizer_title">TV Optimizer</string>
    <string name="tv_optimizer_subtitle">Speed up older TV by safely disabling preinstalled apps</string>
    <string name="tv_optimizer_welcome_title">Speed up your TV</string>
    <string name="tv_optimizer_welcome_body">Speed up an older TV: we will disable unnecessary preinstalled apps. Nothing is deleted, and everything can be restored with a single tap.</string>
    <string name="tv_optimizer_start">Get started</string>
    <string name="tv_optimizer_debug_title">Enable ADB Debugging</string>
    <string name="tv_optimizer_debug_subtitle">Follow these steps on your TV with your remote:</string>
    <string name="tv_optimizer_debug_step1">Open Settings → About</string>
    <string name="tv_optimizer_debug_step2">Click \"Build number\" 7 times until Developer options are unlocked</string>
    <string name="tv_optimizer_debug_step3">Go back → Developer options</string>
    <string name="tv_optimizer_debug_step4">Enable \"USB debugging\" and \"Network debugging / Wi-Fi debugging\"</string>
    <string name="tv_optimizer_debug_step5">Check your TV\'s IP address in Network settings</string>
    <string name="tv_optimizer_cant_find">Can\'t find it?</string>
    <string name="tv_optimizer_cant_find_hint">On some TV models, \"Build number\" is inside \"System\" or \"Android TV OS build\".</string>
    <string name="tv_optimizer_connect_title">Connect to TV</string>
    <string name="tv_optimizer_searching">Searching for TV in local network\u2026</string>
    <string name="tv_optimizer_ip_hint">IP address of TV (e.g. 192.168.1.50)</string>
    <string name="tv_optimizer_port_hint">Port (default 5555)</string>
    <string name="tv_optimizer_connect_btn">Connect</string>
    <string name="tv_optimizer_status_connected">Connected to TV</string>
    <string name="tv_optimizer_status_prompt">Press \"Allow\" on TV screen</string>
    <string name="tv_optimizer_model_title">Select TV model</string>
    <string name="tv_optimizer_model_detected">Detected automatically</string>
    <string name="tv_optimizer_model_search">Search model\u2026</string>
    <string name="tv_optimizer_packages_title">Select apps to disable</string>
    <string name="tv_optimizer_packages_subtitle">Unused preinstalled apps that can be safely disabled to free up RAM.</string>
    <string name="tv_optimizer_select_recommended">Select recommended</string>
    <string name="tv_optimizer_risk_safe">Safe</string>
    <string name="tv_optimizer_risk_moderate">Caution</string>
    <string name="tv_optimizer_confirm_title">Confirm changes</string>
    <string name="tv_optimizer_confirm_warning">You make changes at your own risk. Applications are only disabled, not removed. The original state is automatically saved, and rollback is available at any time. After a TV firmware update, some changes may reset.</string>
    <string name="tv_optimizer_understand_checkbox">I understand</string>
