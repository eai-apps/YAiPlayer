    <string name="tv_optimizer_vendor_generic">Android TV (Generic)</string>
    <string name="tv_optimizer_vendor_generic_steps">Settings → Device Preferences → About → Click \"Build\" 7 times → Back → Developer Options → USB/Network Debugging</string>
    <string name="tv_optimizer_vendor_xiaomi">Xiaomi Mi TV / TV Box</string>
    <string name="tv_optimizer_vendor_xiaomi_steps">Settings → Device Preferences → About → Click \"Build\" 7 times → Back → Additional Settings → Developer Options → USB Debugging</string>
    <string name="tv_optimizer_vendor_sony">Sony BRAVIA</string>
    <string name="tv_optimizer_vendor_sony_steps">Settings → System → About → Click \"Android TV OS build\" 7 times → Back → System → Developer Options → Debugging</string>
    <string name="tv_optimizer_vendor_tcl">TCL Android TV</string>
    <string name="tv_optimizer_vendor_tcl_steps">Settings → Device Preferences → About → Click \"Build\" 7 times → Back → Developer Options → USB Debugging</string>
    <string name="tv_optimizer_vendor_philips">Philips Android TV</string>
    <string name="tv_optimizer_vendor_philips_steps">All Settings → Android Settings → Device Preferences → About → Click \"Build\" 7 times → Back → Developer Options</string>
    <string name="tv_optimizer_vendor_google">Google TV Streamer / Chromecast</string>
    <string name="tv_optimizer_vendor_google_steps">Settings → System → About → Click \"Android TV OS build\" 7 times → Back → System → Developer Options → Network Debugging</string>

    <string name="pkg_youtube_tv_title">YouTube TV / Unplugged</string>
    <string name="pkg_youtube_tv_desc">Paid TV service app, not standard YouTube. Safe to disable if you don\'t subscribe.</string>
    <string name="pkg_play_games_title">Google Play Games</string>
    <string name="pkg_play_games_desc">Gaming service background sync. Safe to disable if you don\'t play games on TV.</string>
    <string name="pkg_patchwall_title">Xiaomi PatchWall</string>
    <string name="pkg_patchwall_desc">Heavy recommendation screen on Xiaomi TVs. Disabling speeds up UI significantly.</string>
    <string name="pkg_xiaomi_upgrade_title">Xiaomi System Update</string>
    <string name="pkg_xiaomi_upgrade_desc">Background updater for Xiaomi apps. Disable with caution.</string>
    <string name="pkg_sony_sync_title">Sony Bravia Sync</string>
    <string name="pkg_sony_sync_desc">HDMI-CEC companion service for Sony Bravia soundbars and accessories.</string>
    <string name="pkg_tcl_manager_title">TCL TV Manager</string>
    <string name="pkg_tcl_manager_desc">Background diagnostic and banner telemetry app on TCL TVs.</string>
    <string name="pkg_print_spooler_title">Print Spooler</string>
    <string name="pkg_print_spooler_desc">Printer spooler service. TVs do not need printing capabilities.</string>
    <string name="pkg_google_music_title">Google Play Music</string>
    <string name="pkg_google_music_desc">Legacy discontinued music app. Completely safe to disable.</string>
